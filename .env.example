# Скопіюйте в .env і заповніть. .env ніколи не комітиться.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=

TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
TG_WEBHOOK_SECRET=
# tg_user_id адмінів через кому
ADMIN_IDS=

# Секрет для вебхука Telegram (будь-який довгий випадковий рядок: openssl rand -hex 32)
# TG_WEBHOOK_SECRET вище обов'язковий у продакшені.

TZ=Europe/Kyiv

# Домен (піддомен) для Caddy: HTTPS і вебхуки. PUBLIC_URL і DATABASE_URL
# у docker compose виставляються автоматично.
DOMAIN=bot.example.com

# Локально без Docker:
# DATABASE_URL=sqlite:///./data/mds.db
# PUBLIC_URL=        # порожньо → Telegram long polling
