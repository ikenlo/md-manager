# Скопіюйте в .env і заповніть. .env ніколи не комітиться.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Gemini (ai.google.dev) — дешеві масові тексти й картинки; порожньо → тексти через Claude Haiku
GEMINI_API_KEY=
# Порожньо → значення за замовчуванням (gemini-3.1-flash-lite, gemini-nano-banana-2.1)
# GEMINI_TEXT_MODEL=
# GEMINI_IMAGE_MODEL=
# Місячний ліміт на всі AI-виклики, $ (0 — без ліміту)
AI_MONTHLY_BUDGET_USD=30

# Meta Graph API: аналітика Instagram і реклами (токен System User з Business Manager)
META_TOKEN=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=
# Сторінка Facebook (ID) — перегляди й залучення сторінки
META_PAGE_ID=
# META_API_VERSION=v26.0

# Google Ads API — витрати, кліки й конверсії кампаній (docs/MARKETING_ACCESS.md, крок 7)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v22

# AI-аналітик і контент-план на панелі (потрібен ANTHROPIC_API_KEY)
# ANALYST_MODEL=claude-opus-5-5
# ANALYST_DAILY=true
# Контент-план: 1 пост на тиждень (день 0–6, 3 — четвер) і сторіс раз на 2 дні
# CONTENT_POST_WEEKDAY=3
# CONTENT_STORY_EVERY_DAYS=2
# CONTENT_PLAN_AUTO_DAY=25
# MEDIA_DIR=./data/media

# Вхід у MDS Manager (https://<домен>/): логіни MDS Connect, якщо задано MDS_URL.
# Без MDS — пароль власника. SESSION_SECRET: openssl rand -hex 32 (інакше сесії скидаються при перезапуску)
PANEL_PASSWORD=
SESSION_SECRET=

IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=

TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
TG_WEBHOOK_SECRET=
# tg_user_id адмінів через кому
ADMIN_IDS=

# Секрет для вебхука Telegram (будь-який довгий випадковий рядок: openssl rand -hex 32)
# TG_WEBHOOK_SECRET вище обов'язковий у продакшені.

# MDS Connect — джерело правди для записів (порожньо → локальні записи)
MDS_URL=
MDS_TOKEN=
# username бота без @ — для посилань з мітками (/link)
TG_BOT_USERNAME=

TZ=Europe/Kyiv

# Домен (піддомен) для Caddy: HTTPS і вебхуки. PUBLIC_URL і DATABASE_URL
# у docker compose виставляються автоматично.
DOMAIN=bot.example.com

# Локально без Docker:
# DATABASE_URL=sqlite:///./data/mds.db
# PUBLIC_URL=        # порожньо → Telegram long polling
