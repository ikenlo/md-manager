# Згенерувати: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Шлях до SQLite (лише прямі слеші)
DB_PATH=D:/MDsManager/data/mds.db
SESSION_TTL_DAYS=7

# development — http і https; production — http перенаправляється на https, /docs вимкнено
APP_ENV=development
# Публічний домен тунелю (localhost і 127.0.0.1 дозволені завжди). Кілька — через кому.
ALLOWED_HOSTS=manager.ваш-домен.com
# Через кому
CORS_ORIGINS=http://localhost:5173,https://manager.ваш-домен.com

# Звідки приходить cloudflared — лише від цих адрес віримо CF-Connecting-IP і X-Forwarded-Proto
TRUSTED_PROXIES=127.0.0.1,::1
# Ліміт входу на один IP
LOGIN_RATE_LIMIT=5/15minutes

# Диспетчер (Фаза 2)
# true — імітація Meta API (нічого не надсилається назовні); false — поки не підтримується
MOCK_META=true
# Вимкнути воркер черги вихідних (лише для тестів/налагодження)
OUTBOUND_WORKER_ENABLED=true
# Як часто воркер перевіряє чергу вихідних, секунд
OUTBOUND_INTERVAL_SECONDS=30
# Скільки спроб відправки, перш ніж повідомлення стане failed
MAX_OUTBOUND_RETRIES=5
# Пауза перед повтором відправки = це значення × номер спроби, секунд
OUTBOUND_RETRY_BASE_SECONDS=60
# Куди зберігати вкладення (лише прямі слеші)
MEDIA_DIR=D:/MDsManager/media

# --- AI (Ollama local LLM) ---
# On PC with GPU: MOCK_OLLAMA=false, ensure Ollama running (ollama serve).
# qwen3:14b needs ~9 GB VRAM. If issues, use qwen3:8b (~5 GB).
OLLAMA_ENABLED=true
MOCK_OLLAMA=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192
